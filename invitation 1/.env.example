# ===================================
# Configuration Serveur HTTPS
# ===================================
HTTPS=true
PORT=3000
BIND_HOST=0.0.0.0
DISPLAY_HOST=localhost

# ===================================
# Base de donnees Supabase/PostgreSQL
# ===================================
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
DB_SSL=true

# ===================================
# SÉCURITÉ - À PERSONNALISER ABSOLUMENT
# ===================================
# Générer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=CHANGE_ME_WITH_A_STRONG_PASSWORD
SCANNER_TOKEN=CHANGE_ME_WITH_A_STRONG_TOKEN
SESSION_SECRET=CHANGE_ME_WITH_A_STRONG_SECRET

# ===================================
# Site URL
# ===================================
# À définir avec l'adresse IP réelle ou le domaine
SITE_URL=https://192.168.11.104:3000

# ===================================
# WhatsApp (optionnel)
# ===================================
# Recommande : WhatsApp Cloud API officiel (Meta).
# Les messages ephemeres, s'ils sont actives dans WhatsApp, se reglent dans WhatsApp
# et ne peuvent pas etre desactives par l'API.
# WHATSAPP_PROVIDER=meta
# WHATSAPP_CLOUD_TOKEN=...
# WHATSAPP_PHONE_NUMBER_ID=...
# WHATSAPP_TO=243971755175

# ===================================
# Email / Gmail
# ===================================
# Pour Gmail, utilise un mot de passe d'application (pas ton mot de passe normal).
MAIL_USER=your.email@gmail.com
MAIL_PASS=your_gmail_app_password
MAIL_FROM="Système Mariage <your.email@gmail.com>"
ADMIN_EMAIL=your.email@gmail.com

# Si tu utilises un SMTP autre que Gmail, renseigne ces valeurs.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_SECURE=false
# MAIL_SERVICE=gmail

# Secours possibles si deja configures.
# WHATSAPP_API_KEY=...
# WHATSAPP_FROM=...
# CALLMEBOT_PHONE=...
# CALLMEBOT_APIKEY=...
