# ===================================
# Configuration serveur HTTPS
# ===================================
HTTPS=true
PORT=3001
BIND_HOST=0.0.0.0
DISPLAY_HOST=localhost

# ===================================
# Base de donnees PostgreSQL
# ===================================
# IMPORTANT : cette invitation doit utiliser sa propre base PostgreSQL,
# differente de l'invitation 1, pour eviter de melanger les invites.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_INVITATION_2_PROJECT.supabase.co:5432/postgres
DB_SSL=true

# ===================================
# Securite - a personnaliser absolument
# ===================================
# Generer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=CHANGE_ME_WITH_A_STRONG_PASSWORD
SCANNER_TOKEN=CHANGE_ME_WITH_A_STRONG_TOKEN
SERVEUR_PASSWORD=CHANGE_ME_WITH_A_STRONG_SERVER_PASSWORD
SESSION_SECRET=CHANGE_ME_WITH_A_STRONG_SECRET

# ===================================
# Site URL
# ===================================
# A definir avec l'adresse IP reelle ou le domaine de cette invitation.
SITE_URL=https://192.168.11.104:3001

# ===================================
# WhatsApp
# ===================================
# Recommande : WhatsApp Cloud API officiel (Meta).
# Les messages ephemeres, s'ils sont actives dans WhatsApp, se reglent dans WhatsApp
# et ne peuvent pas etre desactives par l'API.
WHATSAPP_PROVIDER=meta
WHATSAPP_CLOUD_TOKEN=...
WHATSAPP_PHONE_NUMBER_ID=...
WHATSAPP_TO=243971755175

# Secours possibles si deja configures.
# WHATSAPP_API_KEY=...
# WHATSAPP_FROM=...
# CALLMEBOT_PHONE=...
# CALLMEBOT_APIKEY=...
