PORT=3000
BIND_HOST=0.0.0.0

# Base de donnees Supabase/PostgreSQL
# Utilise de preference la connexion "Session pooler" Supabase
# pour eviter les soucis IPv6 sur Render.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
DB_SSL=true

ADMIN_PASSWORD=change-me
